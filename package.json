{
  "name": "sfb",
  "version": "1.0.0",
  "description": "подключил typescript, postcss и tailwind",
  "main": "webpack.config.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "webpack --mode development",
    "build": "webpack --mode production",
    "server": "node server/server.js",
    "dev:server": "nodemon server/server.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm start\"",
    "storybook": "storybook dev -p 6006",
    "commit-msg": "cz-customizable-ghooks",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "update-readme": "node scripts/update-readme.js",
    "test:screenshot": "playwright test --grep \"screenshot\"",
    "test:visual": "playwright test --grep \"visual\"",
    "test:visual:baseline": "playwright test tests/visual-baseline.spec.js --update-snapshots",
    "test:visual:compare": "playwright test tests/visual-comparison.spec.js",
    "test:visual:report": "node scripts/visual-testing.js compare"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "cz-customizable-ghooks": "^2.0.0",
    "express": "^5.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.28.4",
    "@commitlint/cli": "^20.1.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-docs": "^10.0.4",
    "@storybook/addon-onboarding": "^10.0.4",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.1",
    "@storybook/react": "^10.0.5",
    "@storybook/react-webpack5": "^10.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "cz-customizable": "^7.5.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.4",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "postcss-nested": "^7.0.2",
    "storybook": "^10.0.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.18",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS -g 'commitlint.js'"
    }
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "commitizen"
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-typescript"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niyaznizamiev-a11y/work.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/niyaznizamiev-a11y/work/issues"
  },
  "homepage": "https://github.com/niyaznizamiev-a11y/work#readme"
}
